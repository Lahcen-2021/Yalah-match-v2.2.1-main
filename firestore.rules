rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: there is deliberately no `match /{document=**} { allow read, write: if false; }`
    // block here. Firestore ORs rule matches — a deny-all wildcard does NOT override the
    // specific allows below it, so the one that used to sit here provided no protection
    // while reading like it did. Anything not matched by a rule below is denied by
    // default; that default IS the safety net.

    // Helper Functions
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { 
      return request.resource.data; 
    }
    
    // Cache Collection — public read, NO client writes.
    //
    // This used to allow create/update to any unauthenticated client, gated only
    // by a shape check that left `data` completely unconstrained. That meant
    // anyone could overwrite cache/matches_YYYY-MM-DD with arbitrary content and
    // the app would render it: full content takeover, not merely cache tampering.
    //
    // Writes now come from the server via the firebase-admin SDK
    // (server/firebaseAdmin.ts), which bypasses these rules entirely. See the
    // header of services/firestoreCache.ts.
    match /cache/{cacheId} {
      allow read: if true;
      allow write: if false;
    }

    function isValidUserDoc(data) {
      return data.keys().hasOnly(['favoriteTeams', 'fcmTokens', 'notificationPrefs', 'updatedAt']) &&
             data.favoriteTeams is list && data.favoriteTeams.size() <= 50 &&
             data.fcmTokens is list && data.fcmTokens.size() <= 10 &&
             data.updatedAt is string;
    }

    // Per-user favorites/preferences — unlike /cache, no public read: only the
    // matching authenticated UID may read or write its own document.
    match /users/{userId} {
      allow read, write: if request.auth != null
                          && request.auth.uid == userId
                          && isValidUserDoc(incoming());
    }

    function isNewVote(d) {
      return d.keys().hasAll(['a','draw','b','updatedAt']) && d.keys().size() == 4
          && d.a is int && d.draw is int && d.b is int && d.updatedAt is string
          && d.a >= 0 && d.draw >= 0 && d.b >= 0
          && (d.a + d.draw + d.b) == 1;
    }
    function isVoteIncrement(prev, next) {
      return next.keys().hasAll(['a','draw','b','updatedAt']) && next.keys().size() == 4
          && next.updatedAt is string
          // Re-assert int, as isNewVote does. Without this a float satisfies both
          // `next.a >= prev.a` and the sum check, so counters could be written as
          // non-integers (e.g. 1.5) and drift out of the intended domain.
          && next.a is int && next.draw is int && next.b is int
          && next.a >= prev.a && next.draw >= prev.draw && next.b >= prev.b
          && (next.a + next.draw + next.b) == (prev.a + prev.draw + prev.b) + 1;
    }

    // Anonymous match-winner voting. Public read; writes may only create a
    // single vote or increment exactly one counter by one. No deletes.
    match /votes/{matchId} {
      allow read: if true;
      allow create: if isValidId(matchId) && isNewVote(incoming());
      allow update: if isValidId(matchId) && isVoteIncrement(resource.data, incoming());
      allow delete: if false;
    }
  }
}
