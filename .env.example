# Copy this file to .env and fill in real values. Never commit .env.

# --- Backend API base ---
# Live backend (Cloudflare Pages Functions + D1). CORS allows yallamatch.online,
# www.yallamatch.online and localhost dev ports. The OLD host `yallamatch.pages.dev`
# is dead — do not use it.
# Client (Vite, browser): baked into the bundle at build time.
VITE_API_BASE=https://yallamatchapi-jdwel.pages.dev
# Node dev/proxy server (server.ts) upstream:
BACKEND_BASE=https://yallamatchapi-jdwel.pages.dev

# --- Phase 1: scraping resilience ---
# Free API key from https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# Per-source kill switch, e.g. "kooora:off,messisporat:on". Unmentioned sources default to on.
SCRAPER_KILL_SWITCH=

# Circuit breaker tuning (optional — sane defaults apply if unset)
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_MS=300000

# --- Phase 2: Firebase Auth + FCM push ---
# Path to (or raw JSON of) a Firebase Admin service account key. Keep out of git.
FIREBASE_ADMIN_CREDENTIALS=

# Web Push certificate public key, from Firebase Console > Project Settings > Cloud Messaging
VAPID_PUBLIC_KEY=

# --- Phase 3: rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
PROXY_RATE_LIMIT_WINDOW_MS=60000
PROXY_RATE_LIMIT_MAX=10

# --- Phase 4: admin panel (/admin) ---
# Required to enable /admin. Pick one strong password — there is only one admin account.
ADMIN_PASSWORD=
# Optional but RECOMMENDED: separate secret used to sign admin session tokens. If
# unset it is derived from ADMIN_PASSWORD, which means anyone who guesses the
# password can also forge tokens directly. Set both to independent values.
ADMIN_TOKEN_SECRET=
# Bump this to invalidate every outstanding admin session immediately (e.g. a token
# leaked, or a laptop was lost) without changing the password. Defaults to 1.
ADMIN_TOKEN_VERSION=1
# Comma-separated origins allowed to call /api/admin/* cross-origin. Empty means
# same-origin only, which is what you want unless the panel is hosted separately.
CORS_ADMIN_ORIGINS=

# --- Reverse proxy ---
# Number of proxies in front of this server (Netlify/Cloudflare/nginx = 1). MUST be
# set when deployed behind one: otherwise req.ip is the proxy's address, so every
# visitor shares a single rate-limit bucket, and if the proxy is on the same host
# the loopback exemption switches rate limiting off entirely. 0 = directly exposed.
TRUST_PROXY=0
# Requests per minute allowed against the HLS segment proxy (/api/hls). One stream
# is many segment requests, so this is deliberately high.
HLS_RATE_LIMIT_MAX=600

# --- News translation (/api/news) ---
# English feed items are translated to Arabic through the first configured
# provider below; with neither set they are served untranslated.
#
# Preferred: the site's own Netlify Function (netlify/functions/translate-news.mts),
# which calls Gemini through the Netlify AI Gateway — no API key to manage.
# Requires: AI enabled on the Netlify site + at least one production deploy.
# Example: TRANSLATE_ENDPOINT=https://www.yallamatch.online/translate-news
TRANSLATE_ENDPOINT=
# Optional shared secret. Set the same value in the Netlify site's env vars so the
# function only accepts calls from this backend (recommended in production).
TRANSLATE_SECRET=

# Fallback: direct Google Gemini API key (used only if TRANSLATE_ENDPOINT is
# unset or the gateway call fails).
GEMINI_API_KEY=
# Last-resort keyless fallback: if neither of the above is configured, news is
# translated via Google's public translate endpoint (no key). Set to "off" to
# disable it and serve English feeds untranslated instead.
NEWS_TRANSLATE_FREE=
